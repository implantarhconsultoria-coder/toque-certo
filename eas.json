{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "testflight": {
      "distribution": "store",
      "ios": {
        "simulator": false
      },
      "autoIncrement": true
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true
    },
    "ads-validation": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_ADMOB_USE_TEST_IDS": "1",
        "EXPO_PUBLIC_AD_DIAGNOSTICS": "1"
      }
    },
    "ads-validation-ios": {
      "distribution": "store",
      "ios": {
        "simulator": false
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ADMOB_USE_TEST_IDS": "1",
        "EXPO_PUBLIC_AD_DIAGNOSTICS": "1"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6830062323",
        "appleTeamId": "44W3VC33H2"
      }
    },
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
