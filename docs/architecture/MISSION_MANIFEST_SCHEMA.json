{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implanta X PRO Mission Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "project_id", "title", "target_agent", "revision", "status", "source_uri", "created_at", "acceptance_criteria"],
  "properties": {
    "mission_id": {"type": "string", "pattern": "^IMX-MIS-[0-9]{4}-[0-9]{3,}$"},
    "project_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "target_agent": {"enum": ["CLAUDE", "GROK", "GPT6", "HUMANO"]},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["NEW", "ACKNOWLEDGED", "IN_PROGRESS", "REPORT_SUBMITTED", "REVIEW", "VALIDATED", "CORRECTIONS_REQUIRED", "BLOCKED", "PUBLISHED"]},
    "source_uri": {"type": "string", "format": "uri"},
    "pdf_uri": {"type": "string", "format": "uri"},
    "created_at": {"type": "string", "format": "date-time"},
    "repository": {"type": "string"},
    "branch": {"type": "string"},
    "parent_mission_id": {"type": "string"},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "permitted_actions": {"type": "array", "items": {"type": "string"}},
    "prohibited_actions": {"type": "array", "items": {"type": "string"}},
    "report_uri": {"type": "string", "format": "uri"},
    "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "executor": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "outcome": {"type": "string"},
    "blockers": {"type": "array", "items": {"type": "string"}}
  }
}
